# Lead delivery — set these as Cloudflare Worker secrets/vars (wrangler secret put,
# or the Cloudflare dashboard → Settings → Variables). The site works WITHOUT them
# (form submissions are logged server-side); set them at go-live so leads reach you.

# Follow Up Boss — creates an event + person for each lead.
# Get it: FUB → Admin → API.
FUB_API_KEY=

# Warranty/service-request routing (optional — sensible defaults baked in).
# A brand-NEW service lead is assigned to FUB_WARRANTY_USER_ID; an existing
# contact is NEVER reassigned (the request just lands on their timeline + a
# FUB Lead Flow rule on the "Home Placer Warranty" source notifies the team).
FUB_WARRANTY_USER_ID=39
FUB_WARRANTY_COLLABORATORS=1,35,46

# Resend — emails the team a copy of each lead (optional if FUB is enough).
# Get it: resend.com → API Keys.
RESEND_API_KEY=
LEADS_TO=leads@hplacer.com
LEADS_FROM=Home Placer <leads@hplacer.com>
# Optional: separate recipient for service/warranty email copies (falls back to LEADS_TO).
WARRANTY_LEADS_TO=
