{
  "name": "hplacer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "manifests": "node scripts/build-manifests.mjs",
    "predev": "node scripts/build-manifests.mjs",
    "prebuild": "node scripts/build-manifests.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "preview": "node scripts/build-manifests.mjs && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "node scripts/build-manifests.mjs && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "portal:dev": "node portal/dev/server.ts",
    "portal:migrate": "node portal/dev/migrate.ts",
    "portal:typecheck": "tsc -p portal/tsconfig.json",
    "portal:test": "node --test portal/tests/*.test.ts",
    "portal:check": "npm run portal:typecheck && npm run portal:test && eslint portal"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.19.11",
    "leaflet": "1.9.4",
    "marked": "^18.0.5",
    "next": "16.3.3",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "1.9.20",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.127.1"
  }
}
