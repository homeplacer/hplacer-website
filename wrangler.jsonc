{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "hplacer-app",
  "account_id": "6caa351d57b30bd04cec8a08e4330ffd",
  "workers_dev": true,
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "images": { "binding": "MLS_IMAGES" },
  "routes": [
    { "pattern": "hplacer.com", "custom_domain": true },
    { "pattern": "www.hplacer.com", "custom_domain": true }
  ],
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "hplacer-app" }
  ],
  "r2_buckets": [
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "hplacer-web-incremental-cache" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }
    ]
  },
  "migrations": [
    { "tag": "v1-isr-queue", "new_sqlite_classes": ["DOQueueHandler"] }
  ]
}
